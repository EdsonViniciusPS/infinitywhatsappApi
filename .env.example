# === App ===
APP_NAME=Infinity WhatsApp API
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# === Security ===
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Chave mestre inicial para bootstrap de tenants/API Keys
ADMIN_MASTER_KEY=change-me-admin-master-key
# Segredo validado no header/query do webhook recebido da Evolution API
EVOLUTION_WEBHOOK_SECRET=change-me-webhook-secret

# === Database (PostgreSQL) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=infinity
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=infinity_api
EVOLUTION_DB=evolution

# URL montada para a API Python (opcional se usar variáveis POSTGRES_*)
DATABASE_URL=postgresql+asyncpg://infinity:change-me-db-password@postgres:5432/infinity_api

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Evolution API ===
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-evolution-global-key
EVOLUTION_IMAGE=atendai/evolution-api:v2.2.3
EVOLUTION_TIMEOUT_SECONDS=30.0

# === Google Gemini AI ===
GEMINI_API_KEY=change-me-gemini-api-key
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PROJECT_ID=projects/457161151634
GEMINI_PROJECT_NUMBER=457161151634
GEMINI_KEY_NAME=infinityWhatsapp
GEMINI_CONVERSATION_TTL_SECONDS=86400

# === Domain / Caddy (VPS Hostinger) ===
DOMAIN=api.seudominio.com.br
WEBHOOK_PUBLIC_URL=https://api.seudominio.com.br/api/v1/webhooks/evolution

# === Backups ===
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=21600
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=604800
LOG_RETENTION_DAYS=7
